// The general test cases. The other test files are listed in CMakeLists.txt (TEST_FILES),
//   each compiled on its own with test/test_common.hpp.

jc313_Date d1;
jc313_Date d2;


TEST_CASE("Dates are equal", "[jc313_Date]")
{
    REQUIRE(d1 == d2);
}

TEST_CASE("Starting Tests", "[jc313_Date]")
{
    std::cout << std::endl;
    std::cout << "Starting Testing: ... Please be patient..." << std::endl;
}


TEST_CASE("++Operator PreFix 999", "[jc313_Date]")
{
    jc313_Date d1{2017, 2, 1};

    ++d1;
    REQUIRE(d1.getYear()  == 2017);
    REQUIRE(d1.getMonth() == 2);
    REQUIRE(d1.getDay()   == 2);
};



TEST_CASE("Date Assignment operator", "[jc313_Date]")
{
    jc313_Date d1{2017, 1, 1};
    jc313_Date d2{2018,12,31};
    d2 = d1;
    REQUIRE(d1.getYear()  == d2.getYear());
    REQUIRE(d1.getMonth() == d2.getMonth());
    REQUIRE(d1.getDay()   == d2.getDay());
    REQUIRE(d1.getYear()  == 2017);
    REQUIRE(d1.getMonth() == 1);
    REQUIRE(d1.getDay()   == 1);
};

TEST_CASE("Get Day of Week Text", "[jc313_Date]")
{
    jc313_Date d1{2017, 1, 1};
    //
    // Test set 1
    //
    d1.setDay(1);
    REQUIRE(d1.getDayText(0) == "Sunday");
    d1.setDay(2);
    REQUIRE(d1.getDayText(0) == "Monday");
    d1.setDay(3);
    REQUIRE(d1.getDayText(0) == "Tuesday");
    d1.setDay(4);
    REQUIRE(d1.getDayText(0) == "Wednesday");
    d1.setDay(5);
    REQUIRE(d1.getDayText(0) == "Thursday");
    d1.setDay(6);
    REQUIRE(d1.getDayText(0) == "Friday");
    d1.setDay(7);
    REQUIRE(d1.getDayText(0) == "Saturday");

    //
    // Test set 2
    //
    d1.setDay(15);
    REQUIRE(d1.getDayText(10) == "Sunday    ");
    d1.setDay(16);
    REQUIRE(d1.getDayText(10) == "Monday    ");
    d1.setDay(17);
    REQUIRE(d1.getDayText(10) == "Tuesday   ");
    d1.setDay(18);
    REQUIRE(d1.getDayText(10) == "Wednesday ");
    d1.setDay(19);
    REQUIRE(d1.getDayText(10) == "Thursday  ");
    d1.setDay(20);
    REQUIRE(d1.getDayText(10) == "Friday    ");
    d1.setDay(21);
    REQUIRE(d1.getDayText(10) == "Saturday  ");


};


TEST_CASE("Method jc313_Date::next_Date()", "[jc313_Date]")
{
    jc313_Date d1{2017, 1, 1};
    jc313_Date d2{2017, 1, 1};
    for (int yyyy = 2017; yyyy < 2020; yyyy++) {
        d1.setYear(yyyy);
        d2.setYear(yyyy);
        for (int ddd = 1; ddd < 366; ddd++)
        {
            d1.set_y_d(yyyy, ddd);
            d2.set_y_d(yyyy, ddd);
            REQUIRE(d1.getNext_Date().strDate() == d2.add_Days(1).strDate());
        }
    }
};

TEST_CASE("Method jc313_Date::prior_Date()", "[jc313_Date]")
{
    jc313_Date d1{2017,12,31};
    jc313_Date d2{2017,12,31};
    for (int yyyy = 2017; yyyy > 2010; yyyy--) {
        d1.setYear(yyyy);
        d2.setYear(yyyy);
        for (int ddd = 365; ddd > 1; ddd--)
        {
            d1.set_y_d(yyyy,ddd);
            d2.set_y_d(yyyy,ddd);
            REQUIRE(d1.getNext_Date().strDate() == d2.add_Days(1).strDate());
        }
    }
};

TEST_CASE("Method jc313_Date::++prefix", "[jc313_Date]")
{
    jc313_Date d1{2017, 1, 1};
    jc313_Date d2{2017, 1, 1};
    REQUIRE(d1.getNext_Date().strDate()   == (++d2).strDate());
};

TEST_CASE("Method jc313_Date::--prefix", "[jc313_Date]")
{
    jc313_Date d1{2017, 1, 1};
    jc313_Date d2{2017, 1, 1};
    REQUIRE(d1.getPriorDate().strDate()   == (--d2).strDate());
};

TEST_CASE("Method jc313_Date::postfix++", "[jc313_Date]")
{
    jc313_Date d1{2017, 1, 1};
    jc313_Date d2{2017, 1, 1};

    // d2 is assigned, then d1 is incremented
       d2 = d1++;

    REQUIRE(d2.getNext_Date().strDate()   == d1.strDate());

};

TEST_CASE("Method jc313_Date::postfix--", "[jc313_Date]")
{
    jc313_Date d1{2017, 1, 1};
    jc313_Date d2{2017, 1, 1};
    jc313_Date d3{2017, 1, 1};
    // d2 is assigned, then d1 is decremented
       d2 = d1--;
    d2 = d2.getPriorDate();
    REQUIRE(d2.strDate() == d1.strDate());
};

TEST_CASE("Method jc313_Date::getAge()", "[jc313_Date]")
{

    jc313_Date dn{};              // date: now
    jc313_Date d1{1940, 1, 1};    // sample birthdate
    int expectedResult = dn.getYear() -  d1.getYear();
    REQUIRE(d1.getAge() == expectedResult);
};


