// split into 8 test cases in 4 files (same checks, same order): one function with ~3650 checks
//   took over a minute to optimize in a Release build
TEST_CASE("Test addDays: -0001 to -3653 (part 1 of 8)", "[jc313_Date]")
{
    jc313_Date d;
    d.setYear(2017);
    d.setMonth(01);
    d.setDay(01);

