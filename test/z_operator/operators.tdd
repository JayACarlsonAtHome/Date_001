TEST_CASE("++Operator PreFix 001", "[jc313_Date]")
{
    jc313_Date d1{2017, 1, 1};
    jc313_Date d2{2017, 1, 1};

    d2 = ++d1;
    REQUIRE(d1.getYear()  == 2017);
    REQUIRE(d1.getMonth() == 1);
    REQUIRE(d1.getDay()   == 2);

    //d1 should == d2
    REQUIRE(d1  == d2);

};

TEST_CASE("++Operator PreFix 002", "[jc313_Date]")
{
    jc313_Date d1{2017, 1, 31};
    jc313_Date d2{2017, 1, 1};

    d2 = ++d1;
    REQUIRE(d1.getYear()  == 2017);
    REQUIRE(d1.getMonth() == 2);
    REQUIRE(d1.getDay()   == 1);

    //d1 should == d2
    REQUIRE(d1  == d2);
};

