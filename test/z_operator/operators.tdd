TEST_CASE("Operator++ PostFix 013", "[jc313_Date]")
{
    jc313_Date d1{2017, 7, 1};
    jc313_Date d2{2017, 1, 1};

    d2 = d1++;
    REQUIRE(d1.getYear()  == 2017);
    REQUIRE(d1.getMonth() == 7);
