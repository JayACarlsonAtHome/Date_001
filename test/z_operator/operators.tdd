

TEST_CASE("Operator== Verification", "[jc313_Date]")
{
    jc313_Date d1{2017, 1, 1};
    jc313_Date d2{2017, 1, 1};

    REQUIRE(d1 == d2);
    REQUIRE(!(d1 < d2));
    REQUIRE(!(d1 > d2));
    REQUIRE(!(d2 < d1));
    REQUIRE(!(d2 > d1));
};

